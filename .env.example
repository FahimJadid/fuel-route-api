DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-for-anything-but-local-development
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgis://fuel:fuel@db:5432/fuel
REDIS_URL=redis://redis:6379/1

OSRM_BASE_URLS=https://router.project-osrm.org,https://routing.openstreetmap.de/routed-car
ROUTING_TIMEOUT_SECONDS=10
ROUTE_CACHE_SECONDS=86400

FUEL_CORRIDOR_MILES=10
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
